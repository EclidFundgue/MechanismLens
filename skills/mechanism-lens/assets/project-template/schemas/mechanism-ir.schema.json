{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mechanism-lens.local/schema/mechanism-ir.schema.json",
  "title": "MechanismLens Mechanism IR",
  "type": "object",
  "required": ["id", "title", "question", "sources", "participants", "states", "scenarios"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "participants": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "states": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "source": { "type": "object", "required": ["id", "kind"], "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["paper", "code"] } }, "additionalProperties": false },
    "evidenceRef": { "type": "object", "required": ["sourceId", "evidenceId"], "properties": { "sourceId": { "$ref": "#/$defs/id" }, "evidenceId": { "$ref": "#/$defs/id" } }, "additionalProperties": false },
    "sourceRef": { "type": "object", "required": ["sourceId", "objectId"], "properties": { "sourceId": { "$ref": "#/$defs/id" }, "objectId": { "$ref": "#/$defs/id" } }, "additionalProperties": false },
    "item": { "type": "object", "required": ["id", "title"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 }, "description": { "type": "string" }, "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } }, "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } } }, "additionalProperties": false },
    "step": { "type": "object", "required": ["id", "explanation", "basis", "evidenceRefs"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "explanation": { "type": "string", "minLength": 1 }, "basis": { "enum": ["source_fact", "static_inference", "runtime_observation"] }, "participantIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "stateChanges": { "type": "array", "items": { "type": "string" } }, "condition": { "type": "string" }, "evidenceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceRef" } } }, "additionalProperties": false },
    "scenario": { "type": "object", "required": ["id", "title", "basis", "assumptions", "steps", "branches", "unresolved"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 }, "basis": { "enum": ["source_fact", "static_inference", "runtime_observation"] }, "assumptions": { "type": "array", "items": { "type": "string" } }, "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }, "branches": { "type": "array", "items": { "type": "object" } }, "unresolved": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false }
  }
}
