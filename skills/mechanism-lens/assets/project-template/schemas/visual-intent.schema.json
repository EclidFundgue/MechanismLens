{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mechanism-lens.local/schema/visual-intent.schema.json",
  "title": "MechanismLens Visual Intent",
  "type": "object",
  "required": ["mechanismId", "worlds", "scenes"],
  "properties": {
    "mechanismId": { "$ref": "#/$defs/id" },
    "title": { "type": "string" },
    "worlds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/world" } },
    "scenes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scene" } }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "idList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "object": { "type": "object", "required": ["id", "kind"], "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["group", "node", "card", "annotation", "equation", "code", "chart", "image"] }, "parentId": { "$ref": "#/$defs/id" }, "mechanismRef": { "$ref": "#/$defs/id" }, "label": { "type": "string" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } }, "additionalProperties": true },
    "relation": { "type": "object", "required": ["id", "from", "to"], "properties": { "id": { "$ref": "#/$defs/id" }, "from": { "$ref": "#/$defs/id" }, "to": { "$ref": "#/$defs/id" }, "mechanismRef": { "$ref": "#/$defs/id" }, "label": { "type": "string" } }, "additionalProperties": true },
    "frame": { "type": "object", "required": ["id", "targetIds", "mode", "requiredReadableIds"], "properties": { "id": { "$ref": "#/$defs/id" }, "targetIds": { "$ref": "#/$defs/idList" }, "mode": { "enum": ["fit", "tight", "contextual"] }, "requiredReadableIds": { "$ref": "#/$defs/idList" }, "request": { "type": "object", "required": ["reason"], "properties": { "reason": { "enum": ["required_content_unreadable", "inspect_source_detail", "restore_spatial_context"] } }, "additionalProperties": false } }, "additionalProperties": false },
    "detail": { "type": "object", "required": ["id", "title", "explainsObjectId", "templateId", "objects"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "explainsObjectId": { "$ref": "#/$defs/id" }, "templateId": { "$ref": "#/$defs/id" }, "objects": { "type": "array", "items": { "$ref": "#/$defs/object" } }, "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } }, "layout": { "type": "object" } }, "additionalProperties": true },
    "world": { "type": "object", "required": ["id", "templateId", "selection", "objects", "frames"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "templateId": { "$ref": "#/$defs/id" }, "selection": { "type": "object", "required": ["reason"], "properties": { "reason": { "type": "string", "minLength": 1 } }, "additionalProperties": true }, "layout": { "type": "object", "additionalProperties": true }, "objects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/object" } }, "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } }, "frames": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/frame" } }, "detailViews": { "type": "array", "items": { "$ref": "#/$defs/detail" } } }, "additionalProperties": true },
    "step": { "type": "object", "required": ["id", "narration", "frameId", "mechanismStepIds"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "narration": { "type": "string", "minLength": 1 }, "goal": { "type": "string" }, "frameId": { "$ref": "#/$defs/id" }, "mechanismStepIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "visibleIds": { "$ref": "#/$defs/idList" }, "emphasisIds": { "$ref": "#/$defs/idList" }, "activeRelationIds": { "$ref": "#/$defs/idList" }, "requiredReadableIds": { "$ref": "#/$defs/idList" }, "detailViewId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }, "state": { "type": "object", "additionalProperties": true }, "transition": { "type": "object", "properties": { "strategy": { "enum": ["direct", "viaOverview"] }, "durationMs": { "type": "number", "minimum": 0 }, "easing": { "enum": ["linear", "easeInOutCubic"] } }, "additionalProperties": false }, "timing": { "type": "object", "properties": { "holdMs": { "type": "number", "minimum": 0 } }, "additionalProperties": false } }, "additionalProperties": false },
    "scene": { "type": "object", "required": ["id", "title", "contentKind", "worldId", "presentation", "steps"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 }, "eyebrow": { "type": "string" }, "contentKind": { "type": "string" }, "worldId": { "$ref": "#/$defs/id" }, "presentation": { "type": "object", "required": ["treatment", "cameraPolicy", "defaultFrameId"], "properties": { "treatment": { "enum": ["static_emphasis", "progressive_reveal", "parts_then_whole", "overview_detail_spotlight"] }, "cameraPolicy": { "const": "static_first" }, "defaultFrameId": { "$ref": "#/$defs/id" } }, "additionalProperties": false }, "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } } }, "additionalProperties": false }
  }
}
