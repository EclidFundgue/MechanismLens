{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mechanism-lens.local/schema/scene-ir.schema.json",
  "title": "MechanismLens Scene IR",
  "type": "object",
  "required": ["subjectId", "worlds", "scenes"],
  "properties": {
    "subjectId": { "$ref": "#/$defs/id" },
    "title": { "type": "string" },
    "worlds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/world" } },
    "scenes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scene" } }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "idList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "bounds": { "type": "object", "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } }, "additionalProperties": false },
    "object": { "type": "object", "required": ["id", "kind", "x", "y", "width", "height"], "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["group", "node", "card", "annotation", "equation", "code", "chart", "image"] }, "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 }, "mechanismRef": { "$ref": "#/$defs/id" } }, "additionalProperties": true },
    "relation": { "type": "object", "required": ["id", "from", "to", "path"], "properties": { "id": { "$ref": "#/$defs/id" }, "from": { "$ref": "#/$defs/id" }, "to": { "$ref": "#/$defs/id" }, "path": { "type": "string", "minLength": 1 }, "mechanismRef": { "$ref": "#/$defs/id" } }, "additionalProperties": true },
    "anchor": { "type": "object", "required": ["id", "ownerId", "bounds"], "properties": { "id": { "$ref": "#/$defs/id" }, "ownerId": { "$ref": "#/$defs/id" }, "bounds": { "$ref": "#/$defs/bounds" } }, "additionalProperties": false },
    "frame": { "type": "object", "required": ["id", "targetIds", "mode", "requiredReadableIds", "requestReason", "bounds"], "properties": { "id": { "$ref": "#/$defs/id" }, "targetIds": { "$ref": "#/$defs/idList" }, "mode": { "enum": ["fit", "tight", "contextual"] }, "requiredReadableIds": { "$ref": "#/$defs/idList" }, "requestReason": { "anyOf": [{ "enum": ["required_content_unreadable", "inspect_source_detail", "restore_spatial_context"] }, { "type": "null" }] }, "bounds": { "$ref": "#/$defs/bounds" } }, "additionalProperties": false },
    "world": { "type": "object", "required": ["id", "templateId", "bounds", "objects", "relations", "anchors", "frames", "detailViews"], "properties": { "id": { "$ref": "#/$defs/id" }, "templateId": { "$ref": "#/$defs/id" }, "bounds": { "$ref": "#/$defs/bounds" }, "objects": { "type": "array", "items": { "$ref": "#/$defs/object" } }, "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } }, "anchors": { "type": "array", "items": { "$ref": "#/$defs/anchor" } }, "frames": { "type": "array", "items": { "$ref": "#/$defs/frame" } }, "detailViews": { "type": "array", "items": { "type": "object" } } }, "additionalProperties": true },
    "step": {
      "type": "object",
      "required": ["id", "narration", "mechanismStepIds", "evidenceIds", "visual", "camera", "transition", "timing"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "narration": { "type": "string", "minLength": 1 },
        "mechanismStepIds": { "$ref": "#/$defs/idList" },
        "evidenceIds": { "$ref": "#/$defs/idList" },
        "visual": { "type": "object", "required": ["visibleIds", "emphasisIds", "activeRelationIds", "requiredReadableIds", "detailViewId", "state"] },
        "camera": { "type": "object", "required": ["frameId", "requestReason", "targetIds", "mode", "bounds"], "properties": { "frameId": { "$ref": "#/$defs/id" }, "requestReason": { "anyOf": [{ "enum": ["required_content_unreadable", "inspect_source_detail", "restore_spatial_context"] }, { "type": "null" }] }, "targetIds": { "$ref": "#/$defs/idList" }, "mode": { "enum": ["fit", "tight", "contextual"] }, "bounds": { "$ref": "#/$defs/bounds" } }, "additionalProperties": false },
        "transition": { "type": "object", "required": ["strategy", "durationMs", "easing"] },
        "timing": { "type": "object", "required": ["holdMs"] }
      },
      "additionalProperties": true
    },
    "scene": { "type": "object", "required": ["id", "title", "contentKind", "worldId", "evidenceIds", "steps"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 }, "contentKind": { "type": "string" }, "worldId": { "$ref": "#/$defs/id" }, "presentation": { "type": "object" }, "evidenceIds": { "$ref": "#/$defs/idList" }, "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } } }, "additionalProperties": true }
  }
}
