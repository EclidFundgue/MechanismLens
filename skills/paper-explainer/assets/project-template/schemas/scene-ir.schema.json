{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-explainer.local/schema/scene-ir.v2.schema.json",
  "title": "Paper Explainer generated Scene IR 2.0",
  "description": "Generated by compile-content.mjs. Do not edit directly.",
  "type": "object",
  "required": ["schemaVersion", "paperId", "build", "worlds", "scenes"],
  "properties": { "schemaVersion": { "const": "2.0" }, "paperId": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "build": { "type": "object", "required": ["compilerVersion", "templateCatalogVersion", "sourceHash"], "properties": { "compilerVersion": { "type": "string" }, "templateCatalogVersion": { "type": "string" }, "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": false }, "worlds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/world" } }, "scenes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scene" } } },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "idList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "bounds": { "type": "object", "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } }, "additionalProperties": false },
    "object": { "type": "object", "required": ["id", "kind", "x", "y", "width", "height"], "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["group", "node", "card", "annotation", "equation", "code", "chart", "image"] }, "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } }, "additionalProperties": true },
    "relation": { "type": "object", "required": ["id", "from", "to", "path"], "properties": { "id": { "$ref": "#/$defs/id" }, "from": { "$ref": "#/$defs/id" }, "to": { "$ref": "#/$defs/id" }, "path": { "type": "string", "minLength": 1 } }, "additionalProperties": true },
    "anchor": { "type": "object", "required": ["id", "ownerId", "bounds"], "properties": { "id": { "$ref": "#/$defs/id" }, "ownerId": { "$ref": "#/$defs/id" }, "bounds": { "$ref": "#/$defs/bounds" } }, "additionalProperties": false },
    "world": { "type": "object", "required": ["id", "templateId", "bounds", "objects", "relations", "anchors", "detailViews"], "properties": { "id": { "$ref": "#/$defs/id" }, "templateId": { "$ref": "#/$defs/id" }, "bounds": { "$ref": "#/$defs/bounds" }, "objects": { "type": "array", "items": { "$ref": "#/$defs/object" } }, "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } }, "anchors": { "type": "array", "items": { "$ref": "#/$defs/anchor" } }, "detailViews": { "type": "array", "items": { "type": "object" } } }, "additionalProperties": true },
    "step": { "type": "object", "required": ["id", "narration", "visual", "camera", "transition", "timing"], "properties": { "id": { "$ref": "#/$defs/id" }, "narration": { "type": "string", "minLength": 1 }, "visual": { "type": "object", "required": ["visibleIds", "emphasisIds", "activeRelationIds", "detailViewId", "state"] }, "camera": { "type": "object", "required": ["targetIds", "mode", "bounds"], "properties": { "targetIds": { "$ref": "#/$defs/idList" }, "mode": { "enum": ["fit", "tight", "contextual"] }, "bounds": { "$ref": "#/$defs/bounds" } }, "additionalProperties": false }, "transition": { "type": "object", "required": ["strategy", "durationMs", "easing"] }, "timing": { "type": "object", "required": ["holdMs"] } }, "additionalProperties": true },
    "scene": { "type": "object", "required": ["id", "title", "contentKind", "worldId", "steps"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 }, "contentKind": { "type": "string" }, "worldId": { "$ref": "#/$defs/id" }, "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }, "claimIds": { "$ref": "#/$defs/idList" }, "evidenceIds": { "$ref": "#/$defs/idList" } }, "additionalProperties": true }
  },
  "additionalProperties": false
}
